rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Users can read/write their own profile
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Tool ratings — aggregated doc readable by all; user sub-rating writable only by owner
    match /toolRatings/{toolId} {
      allow read: if true;
      allow write: if request.auth != null;

      match /userRatings/{userId} {
        allow read: if request.auth != null;
        allow write: if request.auth != null && request.auth.uid == userId;
      }
    }

    // Tool requests — anyone can read; only auth users can write
    match /toolRequests/{reqId} {
      allow read: if true;
      allow create: if true; // Allow anonymous submissions
      allow update: if request.auth != null; // Only auth users can upvote
      allow delete: if false;
    }
  }
}
