# ============================================================
# _headers — GitHub Pages / Netlify CDN response headers
# https://amazing-tools.github.io/
# ============================================================
# NOTE: GitHub Pages does not natively support _headers files,
# but this file is included for CDN / reverse-proxy setups
# (Cloudflare, Netlify, etc.). Deploy to Netlify to activate.
# ============================================================

/*
  # Security headers
  X-Frame-Options: SAMEORIGIN
  X-Content-Type-Options: nosniff
  X-XSS-Protection: 1; mode=block
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), microphone=(), camera=()
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' https://pagead2.googlesyndication.com https://www.googletagmanager.com https://www.google-analytics.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: https:; frame-src https://googleads.g.doubleclick.net https://tpc.googlesyndication.com;

  # Cache control — HTML (revalidate frequently)
  Cache-Control: public, max-age=3600, must-revalidate

/*.html
  Cache-Control: public, max-age=3600, must-revalidate

# Static assets — cache aggressively
/*.css
  Cache-Control: public, max-age=31536000, immutable

/*.js
  Cache-Control: public, max-age=31536000, immutable

/*.png
  Cache-Control: public, max-age=31536000, immutable

/*.jpg
  Cache-Control: public, max-age=31536000, immutable

/*.jpeg
  Cache-Control: public, max-age=31536000, immutable

/*.webp
  Cache-Control: public, max-age=31536000, immutable

/*.svg
  Cache-Control: public, max-age=31536000, immutable

/*.ico
  Cache-Control: public, max-age=31536000, immutable

/*.woff2
  Cache-Control: public, max-age=31536000, immutable

# Sitemap & ads.txt — no long-term caching
/sitemap.xml
  Cache-Control: public, max-age=86400

/ads.txt
  Cache-Control: public, max-age=86400

/robots.txt
  Cache-Control: public, max-age=86400
